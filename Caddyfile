# The app lives here. Caddy gets and renews the HTTPS certificate on its own.
todo.reynazech.tech {
	root * /srv
	encode gzip
	file_server
}

# Portfolio (github.com/reynazech/Portfolio): the "portfolio" container on this
# Docker network, deployed from /docker/portfolio. It must be running, or the
# main address returns a 502.
reynazech.tech {
	encode zstd gzip
	reverse_proxy portfolio:3000
}

www.reynazech.tech {
	redir https://reynazech.tech{uri} permanent
}
